# Feather Cloud on the Mac mini. Copy to deploy/.env (git-ignored; never commit it) and fill in every value.
# docs/hosting-mac-mini.md explains where each one comes from.

# Database and storage passwords: long random values (openssl rand -hex 24)
POSTGRES_USER=feather
POSTGRES_PASSWORD=
POSTGRES_DB=feather
S3_ACCESS_KEY=feather
S3_SECRET_KEY=

# Keys the fake salts prelogin returns for unknown emails: openssl rand -hex 32
FEATHER_SERVER_SECRET=

# Every account's storage, in bytes (1 GB = 1073741824)
FEATHER_QUOTA_BYTES=1073741824
# Browser origins allowed to call the server (the web app), exact scheme://host[:port]. Empty: browsers are refused.
FEATHER_ALLOWED_ORIGINS=https://app.feathermark.com
# Largest single attachment, in bytes (100 MB)
FEATHER_MAX_BLOB_BYTES=104857600
# Storage capacity in GB (SeaweedFS 1 GB volumes); keep it below the Mac mini's free disk
SEAWEED_VOLUME_MAX=100

# Verification email through your provider (Resend shown; Postmark: smtp.postmarkapp.com, user and password = server token)
FEATHER_SMTP_HOST=smtp.resend.com
FEATHER_SMTP_PORT=587
FEATHER_SMTP_USERNAME=resend
FEATHER_SMTP_PASSWORD=
FEATHER_SMTP_FROM=Feather Cloud <codes@CLOUD_DOMAIN>

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the token in its install command
CLOUDFLARE_TUNNEL_TOKEN=

# Where backup.sh writes (default: ~/FeatherCloudBackups)
# FEATHER_BACKUP_DIR=
