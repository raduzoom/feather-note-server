# Development defaults. Copy to .env (gitignored) and change the passwords and secret for a real server.
POSTGRES_USER=feather
POSTGRES_PASSWORD=feather-dev
POSTGRES_DB=feather
S3_ACCESS_KEY=feather
S3_SECRET_KEY=feather-dev-secret

# Required. Keys the fake salts prelogin returns for unknown emails. Generate with: openssl rand -hex 32
FEATHER_SERVER_SECRET=
# off (self-hosted: every account active with FEATHER_QUOTA_BYTES) or on (hosted Feather Cloud: trials and plans)
FEATHER_BILLING=off
FEATHER_QUOTA_BYTES=10737418240
FEATHER_MAX_BLOB_BYTES=104857600
# true when a reverse proxy (Caddy, nginx) sits in front and sets X-Forwarded-For
FEATHER_TRUST_PROXY=false

# Mail: "log" writes verification codes to the server's output (development, self-hosters without email);
# "smtp" sends them through a provider. Resend example:
# FEATHER_MAIL=smtp
# FEATHER_SMTP_HOST=smtp.resend.com
# FEATHER_SMTP_PORT=587
# FEATHER_SMTP_USERNAME=resend
# FEATHER_SMTP_PASSWORD=re_...
# FEATHER_SMTP_FROM=Feather Cloud <codes@CLOUD_DOMAIN>
